+// Whether a rescan found a parameter's info as it was.
+static bool sameInfo(const clap_param_info_t &a, const clap_param_info_t &b)
+{
+  return a.id == b.id && a.flags == b.flags && a.cookie == b.cookie && a.min_value == b.min_value &&
+         a.max_value == b.max_value && a.default_value == b.default_value &&
+         std::strncmp(a.name, b.name, sizeof(a.name)) == 0 &&
+         std::strncmp(a.module, b.module, sizeof(a.module)) == 0;
+}
